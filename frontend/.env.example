# Frontend development fallback is disabled by default.
# VITE_* values are visible to browser code: never use live/server credentials here.
VITE_ENABLE_LOCAL_DEV_AUTH=false
VITE_LOCAL_DEV_TEST_PASSWORD=
VITE_LOCAL_DEV_SMS_CODE=

# 以下两个 RPT_* 构建期输入由 vite.config.js 通过 loadEnv 读取（前缀 VITE_ / RPT_）。
# 因此它们既可以写在本文件（.env / .env.local / .env.<mode>）里，也可以用 shell 环境变量提供；
# 同名 shell 环境变量优先，不会被本文件覆盖。
# 构建期 API 源，取值必须是完整 origin（如 https://your.domain）；不设则使用本机默认后端 http://127.0.0.1:3200。
# 注意：npm run build:legacy 的生产构建同样读取本键，但脚本先看 shell 环境变量；
# 未显式配置时构建会打印一次醒目告警（产物只指向构建机的回环地址）。
RPT_PROXY_BASE=
# 开发代理目标，只允许 localhost / 127.0.0.1 / ::1 的 http(s) 源；不设则使用本机默认 http://127.0.0.1:3200。
RPT_LOCAL_API_ORIGIN=
