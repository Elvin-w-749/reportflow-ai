# Local-only example. Never copy production secrets into this file.
NODE_ENV=development
# Same values server.js falls back to when you set nothing: loopback bind, port 3200.
# Override HOST (e.g. 0.0.0.0 inside a container) or PORT when they collide with something
# already on your machine; the default keeps the API off your LAN.
HOST=127.0.0.1
PORT=3200

# Release identity markers (deployment-injected, leave commented for local runs).
# Both are read by server.js and the trusted analysis event log; setting either
# one declares a release-shaped process, so NODE_ENV must then be production and
# startup fails closed otherwise. Values are also embedded in signed event rows,
# so keep them immutable per release artifact.
# RPT_RELEASE_ID=20261007-000000-example-api
# RPT_GIT_COMMIT=0000000000000000000000000000000000000000

# Provider credentials are backend-only and remain empty in tracked examples.
# Local development must inject fake/test values from an untracked environment;
# production values come from the approved server-side secret manager.
DEEPSEEK_API_KEY=
ZHIPU_GLM_OCR_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_INPUT_MAX_CHARS=240000
DEEPSEEK_OUTPUT_MAX_TOKENS=131072
# Keep the server request window aligned with the browser analysis timeout.
REQUEST_TIMEOUT_MS=900000

# The Stage 03 GLM-OCR client reads only the server-side placeholder above. Keep
# it empty; inject production values from the approved secret manager only.

# Scanned-PDF OCR. If a numbered institution-query row is missing, retry only
# its page and accept the retry only when the full 1..N structure improves.
SCANNED_PDF_OCR_CONCURRENCY=3
SCANNED_PDF_QUERY_RESCUE_ATTEMPTS=2
SCANNED_PDF_QUERY_RESCUE_TILE_OFFSET=450

# Use one stable, random value of at least 32 UTF-8 bytes per environment.
# It HMACs scope/content identities and encrypts canonical cached results.
# Production startup fails closed when this is absent or too short.
ANALYSIS_CACHE_SECRET=replace-with-at-least-32-random-bytes
# Stable non-secret tenant label used by both the primary and rotation-fallback
# static Bearer. Changing it intentionally starts a separate cache namespace.
ANALYSIS_STATIC_TENANT_ID=local-legacy-api

# Optional explicit invalidation knobs. Bump only when the corresponding
# implementation/contract changes; implementation hashes are also in analysisKey.
CREDIT_ANALYSIS_PIPELINE_VERSION=credit-analysis-v14-global-card-binding-currency-closed
CREDIT_PROMPT_VERSION=credit-facts-v8-query-source
CREDIT_SCHEMA_VERSION=credit-facts-schema-v6-evidence-closure
CREDIT_RULE_VERSION=credit-rules-deterministic-v3
CREDIT_OCR_VERSION=rapidocr-v1
CREDIT_DOCUMENT_MAX_CHARS=1000000
DEEPSEEK_CHUNK_TRIGGER_CHARS=60000
DEEPSEEK_CHUNK_TRIGGER_PAGES=8
DEEPSEEK_CHUNK_MAX_CHARS=40000
DEEPSEEK_CHUNK_MAX_PAGES=3
DEEPSEEK_CHUNK_CONCURRENCY=3
DEEPSEEK_CHUNK_OUTPUT_MAX_TOKENS=32768

# Persistent canonical answers do not expire by default. Set only when a formal
# data-retention policy requires expiry; a version change is the normal reanalysis path.
# ANALYSIS_PERSISTENT_CACHE_TTL_MS=
# ANALYSIS_MEMORY_CACHE_TTL_MS=86400000
# ANALYSIS_MEMORY_CACHE_MAX_ENTRIES=128

DATA_DIR=./data-local
# 生产环境首次创建全新空库时才临时设为 true；建库成功后立即移除。
# 线上常规启动禁止设置，避免 DATA_DIR 配错或持久卷漏挂载时生成假健康空库。
# ALLOW_EMPTY_STORE_BOOTSTRAP=true
JWT_SECRET=replace-with-a-different-local-jwt-secret
DEV_ANALYZE_BEARER=replace-with-a-local-bearer
SMS_PROVIDER=dev
